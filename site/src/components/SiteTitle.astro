---
// The logo and name, plus a picker for the release the guide describes.
// The list of versions is fetched from /versions.json, so the guide for an
// old release still offers the ones that came after it.
import Default from '@astrojs/starlight/components/SiteTitle.astro'

const version = import.meta.env.DOCS_VERSION ?? 'dev'
const base = import.meta.env.BASE_URL
---

<div class="title-row">
  <Default />
  <select class="version" aria-label="Version" data-version={version} data-base={base}>
    <option value="">{version === 'next' ? 'Next' : version}</option>
  </select>
</div>

<script>
  type Version = { id: string; label: string; base: string }
  const select = document.querySelector<HTMLSelectElement>('select.version')!
  const current = select.dataset.version!
  const base = select.dataset.base!
  fetch('/versions.json')
    .then((r) => (r.ok ? r.json() : Promise.reject()))
    .then((versions: Version[]) => {
      select.replaceChildren(
        ...versions.map((v) => {
          const o = new Option(v.label, v.base)
          o.selected = v.id === current
          return o
        }),
      )
      if (!versions.some((v) => v.id === current)) select.prepend(new Option(current, base, true, true))
    })
    .catch(() => {})
  select.addEventListener('change', () => {
    // Keep the reader on the same page in the other version.
    const page = location.pathname.slice(base.length)
    location.href = select.value + page
  })
</script>

<style>
  .title-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }
  .version {
    font: inherit;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-2);
    background: var(--sl-color-gray-6);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    padding: 0.2rem 0.6rem;
    cursor: pointer;
  }
</style>
