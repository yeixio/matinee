---
// A note at the top of the guide for an older release or for main, which
// points to the latest release's guide. The latest release gets none.
import Default from '@astrojs/starlight/components/Banner.astro'

const version = import.meta.env.DOCS_VERSION ?? 'dev'
const latest = import.meta.env.DOCS_LATEST ?? ''
const page = Astro.url.pathname.slice(import.meta.env.BASE_URL.length)
const note =
  version === 'next'
    ? 'This is the guide for the next release, with features that are on main but not released yet.'
    : version !== 'dev' && latest && version !== latest
      ? `This is the guide for Matinee ${version}.`
      : ''
---

{
  note ? (
    <div class="sl-banner" data-pagefind-ignore>
      {note} <a href={`/${page}`} data-fallback="/docs/">Read the guide for the latest release{latest ? ` (${latest})` : ''}</a>.
    </div>
  ) : (
    <Default />
  )
}

<script>
  // This page may be newer than the latest release; then go to its guide's start.
  for (const a of document.querySelectorAll<HTMLAnchorElement>('a[data-fallback]')) {
    a.addEventListener('click', (e) => {
      e.preventDefault()
      fetch(a.href, { method: 'HEAD' })
        .then((r) => (location.href = r.ok ? a.href : a.dataset.fallback!))
        .catch(() => (location.href = a.href))
    })
  }
</script>
