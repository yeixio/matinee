---
// The Roadmap page: what's coming in the next releases, read from
// src/roadmap.json. `pnpm roadmap` refreshes it from the target/* and
// priority/* labels on GitHub.
import '@fontsource-variable/inter'
import '@fontsource-variable/fraunces'
import '../styles/site.css'
import SiteNav from '../components/SiteNav.astro'
import roadmap from '../roadmap.json'

const base = import.meta.env.BASE_URL
const github = 'https://github.com/yeixio/matinee'

type Item = { repo: string; number: number; title: string; target: string; priority: number }
const items = roadmap.items as Item[]
const targets = roadmap.targets.map((t) => ({ ...t, items: items.filter((i) => i.target === t.id) })).filter((t) => t.items.length > 0)

// The apps' repository is private, so only the server's issues link to GitHub.
const link = (i: Item) => (i.repo === 'matinee' ? `${github}/issues/${i.number}` : undefined)
const updated = roadmap.updated
  ? new Date(`${roadmap.updated}T12:00:00Z`).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' })
  : ''
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Roadmap | Matinee media server</title>
    <meta name="description" content="What's coming next in Matinee, the free, open source, self-hosted media server: the next releases and the ideas after them." />
    <link rel="canonical" href={new URL(`${base}roadmap/`, Astro.site).href} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Matinee" />
    <meta property="og:title" content="Matinee roadmap" />
    <meta property="og:description" content="What's coming next in Matinee, the free, open source, self-hosted media server." />
    <meta name="theme-color" content="#100d12" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
  </head>
  <body>
    <SiteNav current="roadmap" />

    <main>
      <section class="roadmap-hero">
        <p class="eyebrow">Roadmap</p>
        <h1>What's coming next</h1>
        <p class="lede">
          The next releases, in the order we plan to ship them. Each server release comes with app updates for the same
          features. Plans change as we learn, so this page follows the issues on GitHub.
        </p>
        <nav class="jump" aria-label="Releases">
          {targets.map((t) => <a href={`#${t.id}`}>{t.label}</a>)}
        </nav>
      </section>

      <section class="targets">
        {
          targets.map((t, index) => (
            <article class="target" id={t.id}>
              <header>
                <span class:list={['tag', { next: index === 0 }]}>{index === 0 ? `Next · ${t.label}` : t.label}</span>
                <h2>{t.name}</h2>
                <p>{t.summary}</p>
              </header>
              <ul>
                {t.items.map((i) => {
                  const href = link(i)
                  return (
                    <li>
                      <span class="where">{i.repo === 'matinee' ? 'Server' : 'Apps'}</span>
                      {href ? <a href={href}>{i.title}</a> : <span class="title">{i.title}</span>}
                      {i.priority === 1 && <span class="top">Top priority</span>}
                    </li>
                  )
                })}
              </ul>
            </article>
          ))
        }
      </section>

      <section class="roadmap-foot">
        <p>
          Missing something? <a href={`${github}/issues/new/choose`}>Ask for it on GitHub</a>, or add a 👍 to an issue so we
          know it matters to you. {updated && <>Last updated {updated}.</>}
        </p>
      </section>
    </main>

    <footer>
      <span>Matinee is free software under the AGPL 3.0 or later.</span>
      <span>
        <a href={`${base}docs/`}>Guide</a> · <a href={`${base}download/`}>Download</a> · <a href={`${github}/releases`}>Releases</a> · <a href={`${github}/issues`}>Issues</a>
      </span>
    </footer>
  </body>
</html>

<style>
  .roadmap-hero {
    text-align: center;
    padding-top: 72px !important;
    padding-bottom: 24px !important;
  }
  .roadmap-hero h1 {
    font-size: clamp(2.2rem, 5vw, 3.6rem);
  }
  .jump {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
  }
  .jump a {
    padding: 6px 14px;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    text-decoration: none;
    font-size: 0.9rem;
  }
  .jump a:hover {
    color: var(--text);
    background: var(--bg-2);
  }

  .targets {
    max-width: 880px !important;
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding-top: 32px !important;
    padding-bottom: 48px !important;
  }
  .target {
    scroll-margin-top: 80px;
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 28px 28px 12px;
  }
  .target h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    margin-top: 10px;
  }
  .tag {
    display: inline-block;
    padding: 3px 10px;
    border-radius: 999px;
    border: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .tag.next {
    background: var(--accent);
    border-color: var(--accent);
    color: #1a0e0c;
  }
  .target ul {
    list-style: none;
    margin: 8px 0 0;
    padding: 0;
  }
  .target li {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 12px 0;
    border-top: 1px solid var(--line);
    line-height: 1.45;
  }
  .target li a,
  .target li .title {
    flex: 1;
    min-width: 0;
    color: var(--text);
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .target li a:hover {
    color: var(--accent-2);
    text-decoration: underline;
  }
  .where {
    flex: 0 0 52px;
    color: var(--muted);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .top {
    flex-shrink: 0;
    color: var(--accent-2);
    font-size: 0.78rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .roadmap-foot {
    max-width: 880px !important;
    padding-bottom: 72px !important;
    text-align: center;
  }

  @media (max-width: 640px) {
    .target {
      padding: 20px 18px 6px;
    }
    .target li {
      flex-wrap: wrap;
      gap: 4px 10px;
    }
    .target li a,
    .target li .title {
      flex-basis: 100%;
      order: 2;
    }
    .where {
      flex-basis: auto;
    }
  }
</style>
