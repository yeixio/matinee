# Matinee settings, read by matinee.service. After a change:
#   sudo systemctl restart matinee
# Every setting is listed at https://github.com/yeixio/matinee#configuration

# Listen address.
#MATINEE_ADDR=:7171

# TMDB key for posters and descriptions. How to get one:
# https://github.com/yeixio/matinee#posters-and-descriptions-tmdb-key
#MATINEE_TMDB_KEY=

# Folder the library picker opens in, such as where your shares are mounted.
#MATINEE_MEDIA_ROOT=/

# PostgreSQL instead of the default SQLite in /var/lib/matinee.
#MATINEE_DATABASE_URL=postgres://matinee:password@localhost:5432/matinee?sslmode=disable
